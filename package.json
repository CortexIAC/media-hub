{
  "name": "bunny-media-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Bunny Media Hub - unified music, video and stream experience for the Bunny ecosystem",
  "author": "Bunny / CortexIAC",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "node node_modules/electron/install.js",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "icon": "node scripts/make-icon.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "check:streams": "node scripts/check-streams.mjs",
    "check:archive": "node scripts/check-archive.mjs",
    "bench": "npm run build && node scripts/benchmark.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "hls.js": "^1.7.3",
    "music-metadata": "^12.3.2"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "libflacjs": "^5.6.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
